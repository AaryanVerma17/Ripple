APP_ENV=development
DATABASE_URL=sqlite:////app/data/ripple.db
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Photo identification (camera feature) -------------------------------------------------
# Get a key at https://aistudio.google.com/apikey . Check the current model name at
# https://ai.google.dev/gemini-api/docs/models and set GEMINI_MODEL to it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# auto | gemini | nebius | off
VISION_PROVIDER=auto

# --- Text model: report summaries + what-if chat wording (Nebius Token Factory, OpenAI-compatible)
# Copy the exact base URL and model ID from your Nebius console. Leave empty to run without it:
# the deterministic engine, the chat parser and the photo feature all still work.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=
NEBIUS_MODEL=
NEBIUS_TIMEOUT_SECONDS=35
# set true only if your model supports response_format=json_object
NEBIUS_JSON_MODE=false
# optional: a Nebius vision model, used when VISION_PROVIDER=nebius
NEBIUS_VISION_MODEL=

MAX_UPLOAD_MB=8
AI_RATE_LIMIT_PER_MINUTE=20
