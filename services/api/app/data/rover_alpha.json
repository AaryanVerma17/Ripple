   "basis": "recorded"
  },
  {
   "id": "R-MTR-RAIL-OV",
   "title": "Rail is no more than 110 % of the motor's rated voltage",
   "category": "electrical_compatibility",
   "group": "electrical",
   "lhs": {
    "entity": "PWR-01",
    "param": "rail_voltage"
   },
   "op": "<=",
   "rhs": {
    "entity": "MTR-01",
    "param": "rated_voltage",
    "factor": 1.1
   },
   "basis": "assumption",
   "rail_coupled": true,
   "assumption": "Motors are expected to run between 80 % and 110 % of rated voltage (project assumption)."
  },
  {
   "id": "R-MTR-RAIL-UV",
   "title": "Rail is at least 80 % of the motor's rated voltage",
   "category": "electrical_compatibility",
