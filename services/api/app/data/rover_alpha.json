 "rules": [
  {
   "id": "R-DRV-IN-MAX",
   "title": "Rail voltage is within the driver's maximum input",
   "category": "electrical_compatibility",
   "group": "electrical",
   "lhs": {
    "entity": "PWR-01",
    "param": "rail_voltage"
   },
   "op": "<=",
   "rhs": {
